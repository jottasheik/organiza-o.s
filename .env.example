# ========================================================
# CONFIGURAÇÃO DE DESENVOLVEDOR (GOOGLE CLOUD & FIREBASE)
# Preencha uma única vez. Seus clientes verão apenas o botão
# "Entrar com o Google" e não precisarão configurar nada!
# ========================================================

PORT=3000

# 1. GOOGLE CLOUD OAUTH (Google Calendar & Sheets APIs)
# Obtenha em: Google Cloud Console > APIs e Serviços > Credenciais > ID do cliente OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 2. FIREBASE (Configurações Públicas do Frontend)
# Obtenha em: Firebase Console > Configurações do Projeto > Geral > Seus apps > Configuração Web
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# 3. FIREBASE ADMIN (Backend / Firestore / Custom Tokens)
# Baixe a chave em: Firebase Console > Configurações do Projeto > Contas de serviço > Gerar nova chave privada
# Salve o arquivo JSON na raiz como "serviceAccountKey.json" OU preencha abaixo:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# 4. CHAVE DE CRIPTOGRAFIA PARA REFRESH TOKENS
# Pode deixar esta ou digitar qualquer senha longa segura
SESSION_SECRET=alta-performance-direito-bancario-segredo-2026-xyz
